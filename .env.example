# Copy to .env and fill in. NEVER commit .env (it is in .gitignore). In Dokploy: paste into Environment.
# LiveKit Cloud → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LLM via the OpenAI SDK. Gemini (OpenAI-compatible endpoint): key from aistudio.google.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Speech
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional: native-speaker Cartesia voice ids per language (play.cartesia.ai → filter by language)
CARTESIA_VOICE_TR=
CARTESIA_VOICE_EN=
# Shared key between the mobile app and this API (>= 16 chars). It ships inside the APK, so it is NOT a
# secret: it only identifies the app build. Real auth = your own login (JWT).
DEMO_API_KEY=change-me-to-a-long-random-string
# Long-term memory. Local: `docker compose up -d`. Prod compose builds DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://mira:mira@localhost:5433/mira
POSTGRES_PASSWORD=
PORT=3000
# Public-demo cost guards
MAX_SESSIONS_PER_DAY=200
MAX_CALL_MINUTES=10
AWAY_HANGUP_SECONDS=60
# 1 when running behind a reverse proxy (Dokploy/Traefik) so rate limits see the real client IP
TRUST_PROXY=0
