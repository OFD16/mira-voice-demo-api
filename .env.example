# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# LiveKit Cloud → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Shared secret between the mobile app and this API (demo-level auth; >= 16 chars)
DEMO_API_KEY=change-me-to-a-long-random-string
# Optional: long-term memory (docker compose up -d)
DATABASE_URL=postgres://mira:mira@localhost:5433/mira
PORT=3000
